extends SceneTree
## Writes data/art/gear_visuals.json from the item data (ASSETS.md section 8): item id -> generator + parameters.
## Run by tools/build_assets.py before Blender, so every equippable item always has a visual entry.
## Hand tweaks belong in data/art/gear_visuals_overrides.json (merged on top, same shape).
## Run: godot --headless --path . --script res://tools/dev/gen_gear_visuals.gd

const OUT := "res://data/art/gear_visuals.json"
const OVERRIDES := "res://data/art/gear_visuals_overrides.json"
const SLOTS := ["weapon", "shield", "head", "body", "legs", "feet", "hands", "cape", "ammo"]

const ARMOUR_GEN := {
	"plate": {"head": "plate_helm", "body": "plate_body", "legs": "plate_legs", "feet": "plate_boots", "shield": "kiteshield"},
	"hide": {"head": "hide_coif", "body": "hide_body", "legs": "hide_chaps", "hands": "hide_vambraces", "feet": "hide_boots"},
	"robe": {"head": "robe_hat", "body": "robe_top", "legs": "robe_bottom", "hands": "robe_gloves", "feet": "robe_boots"},
}
const CLASS_FAMILY := {"plate": "metal", "hide": "hide", "robe": "robe"}
const SIDEGRADE := {"berserker_plate": "berserker", "bulwark_plate": "bulwark", "duelist_plate": "duelist",
	"armoured_hide": "armoured", "skirmisher_hide": "skirmisher", "trackers_leathers": "trackers",
	"warded_robes": "warded", "sorcerers_robes": "sorcerers", "battlemage_robes": "battlemage"}
## Unique (non-tiered) items: generator + main swatch.
const UNIQUE := {
	"whip": ["whip", "u.whip"], "stone_maul": ["stone_maul", "u.maul"], "greatblade": ["greatblade", "u.greatblade"],
	"claws": ["claws", "u.claws"], "void_blade": ["void_blade", "u.voidblade"], "javelins": ["javelins", "wood.mid"],
	"duskbow": ["duskbow", "u.duskbow"], "heavy_ballista": ["heavy_ballista", "u.ballista"],
	"sunfire_crossbow": ["sunfire_crossbow", "u.sunfire"], "forbidden_staff": ["forbidden_staff", "u.forbidden"],
	"eruption_staff": ["eruption_staff", "u.eruption"], "tempest_staff": ["tempest_staff", "u.tempest"],
	"arcane_tome": ["tome", "tome.arcane"], "novice_tome": ["tome", "tome.novice"], "starbound_tome": ["tome", "tome.star"],
	"wyrmbone_tome": ["tome", "tome.wyrmbone"], "archers_buckler": ["buckler", "u.buckler"],
	"melee_cape": ["cape", "cape.melee"], "ranged_cape": ["cape", "cape.ranged"], "magic_cape": ["cape", "cape.magic"],
	"mages_mantle": ["mantle", "cape.mantle"], "archers_quiver": ["quiver", "u.quiver"], "fletchers_pouch": ["pouch", "u.pouch"],
	"eagle_eye_coif": ["hide_coif", "u.eagle_coif"], "rangers_boots": ["hide_boots", "u.ranger_boots"],
	"wizard_boots": ["robe_boots", "u.wizard_boots"], "diamond_bolts": ["bolt", "bolt.diamond"],
	"dragonfire_bolts": ["bolt", "bolt.dragonfire"], "onyx_bolts": ["bolt", "bolt.onyx"],
}

var palette: Dictionary = {}


func _init() -> void:
	DB.ensure_loaded()
	var pf := FileAccess.open("res://assets/palette/palette.json", FileAccess.READ)
	palette = JSON.parse_string(pf.get_as_text())
	var out := {}
	var ids: Array = DB.items.keys()
	ids.sort()
	var missing: Array = []
	for id in ids:
		var it: Dictionary = DB.items[id]
		if not str(it.get("slot", "")) in SLOTS:
			continue
		var v := _visual(str(id), it)
		if v.is_empty():
			missing.append(id)
			continue
		out[id] = v
	var ov := FileAccess.open(OVERRIDES, FileAccess.READ)
	if ov != null:
		var o: Dictionary = JSON.parse_string(ov.get_as_text())
		for id in o.get("items", {}):
			var base: Dictionary = out.get(id, {})
			base.merge(o["items"][id], true)
			out[id] = base
	var doc := {"_doc": "GENERATED by tools/dev/gen_gear_visuals.gd from the item data (put hand tweaks in "
		+ "gear_visuals_overrides.json). item id -> model file (assets/models/gear/<model>.glb), generator "
		+ "('gen', a function in art/blender/gear/), tier and palette swatches ('sw': role -> swatch).",
		"items": out}
	var f := FileAccess.open(OUT, FileAccess.WRITE)
	f.store_string(JSON.stringify(doc, " ", false) + "\n")
	print("VISUALS %d items" % out.size())
	for m in missing:
		print("MISSING ", m)
	quit(1 if not missing.is_empty() else 0)


func _tier_swatches(tier: int, family: String) -> Dictionary:
	var mat := str((palette["tiers"] as Dictionary)[str(tier)][family])
	var sw := {}
	for role in ["base", "dark", "light", "trim", "accent"]:
		sw[role] = "%s.%s" % [mat, role]
	sw["wood"] = str((palette["tiers"] as Dictionary)[str(tier)]["wood"])
	sw["metal"] = "%s.base" % str((palette["tiers"] as Dictionary)[str(tier)]["metal"])
	sw["metal_dark"] = "%s.dark" % str((palette["tiers"] as Dictionary)[str(tier)]["metal"])
	return sw


func _has(sw: String) -> bool:
	return (palette["swatches"] as Dictionary).has(sw)


func _visual(id: String, it: Dictionary) -> Dictionary:
	var tier := clampi(int(it.get("tier", 1)), 1, 7)
	var slot := str(it.get("slot", ""))
	if UNIQUE.has(id):
		var u: Array = UNIQUE[id]
		var sw := _tier_swatches(tier, "metal")
		for role in ["base", "dark", "light"]:
			sw[role] = u[1]
		sw["trim"] = "gold"
		var v := {"model": id, "gen": u[0], "family": id, "tier": tier, "sw": sw, "unique": true}
		if u[0] in ["hide_coif", "hide_boots", "robe_boots", "bolt"]:
			v["variant"] = id
		return v
	var cls := str(it.get("armour_class", ""))
	if cls != "" and ARMOUR_GEN.has(cls):
		var gen: String = (ARMOUR_GEN[cls] as Dictionary).get(slot, "")
		if gen == "":
			return {}
		var sw := _tier_swatches(tier, CLASS_FAMILY[cls])
		var v := {"model": id, "gen": gen, "family": gen, "tier": tier, "sw": sw}
		var set_id := str(it.get("set", ""))
		if SIDEGRADE.has(set_id):
			var sg := "sg." + str(SIDEGRADE[set_id])
			sw["base"] = sg
			sw["dark"] = sg
			if _has(sg + ".trim"):
				sw["trim"] = sg + ".trim"
			v["variant"] = set_id
		if gen == "plate_helm":
			v["full_helm"] = true
		return v
	var wt := str(it.get("weapon_type", ""))
	if wt != "":
		var fam := "metal"
		if wt in ["shortbow", "longbow"]:
			fam = "metal"
		var sw := _tier_swatches(tier, fam)
		if wt in ["staff", "wand"]:
			sw = _tier_swatches(tier, "robe")
		return {"model": id, "gen": wt, "family": wt, "tier": tier, "sw": sw}
	var ammo := str(it.get("ammo_type", ""))
	if ammo != "":
		return {"model": id, "gen": ammo, "family": ammo, "tier": tier, "sw": _tier_swatches(tier, "metal")}
	return {}
